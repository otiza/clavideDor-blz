@page "/game/{gameSessionId:int}"
@rendermode InteractiveServer
@inject GameViewModel ViewModel
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="game-page container-fluid mt-4" @onkeydown:window="HandleKeyDown">
    @if (ViewModel.IsLoading && ViewModel.CurrentQuestion == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger">
            <h4>Error</h4>
            <p>@ViewModel.ErrorMessage</p>
            <button class="btn btn-primary" @onclick="OnGoBack">Back</button>
        </div>
    }
    else if (ViewModel.CurrentQuestion == null)
    {
        <div class="alert alert-success">
            <h4>Game Finished!</h4>
            <p>Final Score: @ViewModel.CurrentSession?.Score</p>
            <button class="btn btn-primary" @onclick="OnViewResults">Results</button>
            <button class="btn btn-secondary" @onclick="OnGoBack">Menu</button>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-md-9">
                <div class="card game-card shadow">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Question @ViewModel.CurrentQuestionIndex</h5>
                        @if (ViewModel.CurrentQuestion?.IsBoss == true)
                        {
                            <span class="badge text-bg-danger">BOSS</span>
                        }
                    </div>
                    <div class="card-body">
                        <p class="question-text mb-4">@ViewModel.CurrentQuestion?.Text</p>

                        @if (!ViewModel.Answered)
                        {
                            <div class="mb-3 answer-grid">
                                @{
                                    var opts = new[] { ("A", ViewModel.CurrentQuestion?.ChoiceA), ("B", ViewModel.CurrentQuestion?.ChoiceB), ("C", ViewModel.CurrentQuestion?.ChoiceC), ("D", ViewModel.CurrentQuestion?.ChoiceD) };
                                }
                                @foreach (var (l, t) in opts)
                                {
                                    if (!ViewModel.HiddenWrongAnswers.Contains(l))
                                    {
                                        var selectedClass = ViewModel.SelectedAnswer == l ? "btn-primary text-white" : "btn-outline-primary";
                                        <button class="btn @selectedClass w-100 mb-2 text-start" @onclick="@(() => SelectAnswer(l))">@l) @t</button>
                                    }
                                }
                            </div>
                            <div class="small text-muted mb-2">Tip: use keyboard keys <strong>A</strong>, <strong>B</strong>, <strong>C</strong>, <strong>D</strong> to select an answer.</div>
                            @if (ViewModel.ShowHint)
                            {
                                <div class="alert alert-warning">@ViewModel.HintText</div>
                            }
                            <button class="btn btn-primary w-100" @onclick="OnSubmitAnswer" disabled="@(string.IsNullOrEmpty(ViewModel.SelectedAnswer) || ViewModel.IsLoading)">Submit</button>
                            @if (ViewModel.IsJokerAvailable())
                            {
                                <button class="btn btn-warning w-100 mt-2" @onclick="OnUseJoker">@ViewModel.GetJokerButtonText()</button>
                            }
                        }
                        else
                        {
                            <div class="alert @(ViewModel.AnswerCorrect ? "alert-success" : "alert-danger")">
                                @(ViewModel.AnswerCorrect ? "Correct!" : "Wrong! Answer: " + ViewModel.CurrentQuestion?.Correct)
                            </div>
                            @if (ViewModel.ShowRetryOption)
                            {
                                <button class="btn btn-info w-100 mb-2" @onclick="OnRetryQuestion">Retry</button>
                            }
                            <button class="btn btn-primary w-100" @onclick="OnNextQuestion">Next</button>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card game-side-card shadow">
                    <div class="card-body">
                        <p><strong>Score:</strong> @ViewModel.CurrentSession?.Score</p>
                        <p><strong>Progress:</strong> @ViewModel.TotalQuestionsAnswered</p>
                        <button class="btn btn-sm btn-secondary w-100 mb-2" @onclick="OnSaveProgress">Save</button>
                        <button class="btn btn-sm btn-danger w-100" @onclick="OnQuitGame">Quit</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DotNetObjectReference<Game>? _selfReference;

    [Parameter]
    public int GameSessionId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync(GameSessionId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("registerGameKeyListener", _selfReference);
    }

    private void SelectAnswer(string answer) => ViewModel.SelectedAnswer = answer;
    private async Task OnSubmitAnswer() => await ViewModel.SubmitAnswerAsync();
    private async Task OnUseJoker() => await ViewModel.UseJokerAsync();
    private async Task OnNextQuestion()
    {
        if (!await ViewModel.NextQuestionAsync())
        {
            await ViewModel.FinishGameAsync();
            StateHasChanged();
        }
    }
    private async Task OnRetryQuestion() => await ViewModel.RetryQuestionAsync();
    private async Task OnSaveProgress() => await ViewModel.SaveProgressAsync();
    private async Task OnQuitGame()
    {
        if (await JS.InvokeAsync<bool>("confirm", "Quit game?"))
        {
            await ViewModel.SaveProgressAsync();
            NavigationManager.NavigateTo("/mainmenu");
        }
    }
    private void OnGoBack() => NavigationManager.NavigateTo("/mainmenu");
    private void OnViewResults() => NavigationManager.NavigateTo($"/result/{ViewModel.GameSessionId}");
    [JSInvokable]
    public Task OnKeyPressed(string key)
    {
        if (ViewModel.IsLoading || ViewModel.Answered || ViewModel.CurrentQuestion == null)
            return Task.CompletedTask;

        var normalizedKey = key.Trim().ToUpperInvariant();
        if (normalizedKey is not ("A" or "B" or "C" or "D"))
            return Task.CompletedTask;

        if (ViewModel.HiddenWrongAnswers.Contains(normalizedKey))
            return Task.CompletedTask;

        ViewModel.SelectedAnswer = normalizedKey;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleKeyDown(KeyboardEventArgs args)
        => OnKeyPressed(args.Key ?? string.Empty);

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await JS.InvokeVoidAsync("unregisterGameKeyListener");
        _selfReference?.Dispose();
    }
}
