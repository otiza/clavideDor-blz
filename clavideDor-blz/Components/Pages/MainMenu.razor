@page "/mainmenu"
@rendermode InteractiveServer
@inject MainMenuViewModel ViewModel
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<div class="menu-page py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="menu-card shadow-lg">
                <h1 class="display-5 text-center mb-2">🎮 Clavier d'Or</h1>
                <p class="lead text-center text-muted mb-4">Quiz Game Platform</p>
            
                @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @ViewModel.ErrorMessage
                        <button type="button" class="btn-close" @onclick="() => ClearError()"></button>
                    </div>
                }

                @if (ViewModel.IsLoading)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="btn-group-vertical w-100 gap-2" role="group">
                        <button type="button" class="btn btn-primary btn-lg" @onclick="OnNewGame" disabled="@ViewModel.IsLoading">
                            New Game
                        </button>
                        @if (ViewModel.HasUnfinishedGame)
                        {
                            <select class="form-select" @bind="ViewModel.SelectedResumeSessionId">
                                @foreach (var session in ViewModel.UnfinishedGames)
                                {
                                    <option value="@session.Id">@ViewModel.GetResumeOptionLabel(session)</option>
                                }
                            </select>
                        }
                        <button type="button" class="btn btn-outline-primary btn-lg" @onclick="OnResumeGame" disabled="@(!ViewModel.HasUnfinishedGame || ViewModel.IsLoading)">
                            @ViewModel.ResumeGameButtonText
                        </button>
                        <button type="button" class="btn btn-outline-light btn-lg" @onclick="OnHistory" disabled="@ViewModel.IsLoading">
                            History
                        </button>
                        <button type="button" class="btn btn-danger btn-lg" @onclick="OnQuit" disabled="@ViewModel.IsLoading">
                            Quit
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
    }

    private async Task OnNewGame()
    {
        await ViewModel.OnNewGameAsync();
        NavigationManager.NavigateTo("/newgame");
    }

    private async Task OnResumeGame()
    {
        await ViewModel.OnResumeGameAsync();
        if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
            return;
        NavigationManager.NavigateTo($"/game/{ViewModel.ResumeGameSessionId}");
    }

    private async Task OnHistory()
    {
        await ViewModel.OnHistoryAsync();
        NavigationManager.NavigateTo("/history");
    }

    private void OnQuit()
    {
        ViewModel.OnQuit();
    }

    private void ClearError()
    {
        ViewModel.ErrorMessage = string.Empty;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        // Cleanup if needed
    }
}
