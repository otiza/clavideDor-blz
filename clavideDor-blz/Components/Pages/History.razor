@page "/history"
@rendermode InteractiveServer
@inject HistoryViewModel ViewModel
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>Game History</h2>
        </div>
        <div class="col-md-4">
            <button class="btn btn-secondary" @onclick="OnGoBack">Back to Menu</button>
        </div>
    </div>

    @if (ViewModel.IsLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger">
            <h4>Error</h4>
            <p>@ViewModel.ErrorMessage</p>
        </div>
    }
    else
    {
        <div class="mb-3">
            <input type="text" class="form-control" placeholder="Search by player name..." @bind="ViewModel.FilterText" />
        </div>

        @if (ViewModel.FilteredSessions.Count == 0)
        {
            <div class="alert alert-info">
                <p>No game history found. Start playing to see your games here!</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Player</th>
                            <th>Role</th>
                            <th>Score</th>
                            <th>Questions</th>
                            <th>Finished</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in ViewModel.FilteredSessions)
                        {
                            <tr>
                                <td>@session.Player?.Name</td>
                                <td>@ViewModel.GetRoleDisplayName(session.Player?.Role)</td>
                                <td><span class="badge bg-success">@session.Score</span></td>
                                <td>@session.AnsweredQuestions.Count</td>
                                <td>@ViewModel.FormatDate(session.FinishedAt)</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="@(() => OnViewDetails(session.Id))">Details</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadHistoryAsync();
    }

    private void OnGoBack()
    {
        NavigationManager.NavigateTo("/mainmenu");
    }

    private void OnViewDetails(int gameSessionId)
    {
        NavigationManager.NavigateTo($"/result/{gameSessionId}");
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        // Cleanup if needed
    }
}

